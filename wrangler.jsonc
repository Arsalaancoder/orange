{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orange",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orange-paramedical-db",
      "database_id": "18eb960e-83e3-49e3-a59a-f8be6007d1b6"
    }
  ],
  "vars": {
    "CLERK_AUTHORIZED_PARTIES": "https://orangecolleges.com,https://www.orangecolleges.com"
  }
}
